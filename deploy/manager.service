# systemd unit (portability — the Windows path is scripts/MANAGER.bat via
# Task Scheduler ONLOGON; delivery backend pending GitHub Actions decision)
[Unit]
Description=Sleeper fantasy auto-manager
After=network-online.target

[Service]
WorkingDirectory=/opt/fantasy-football
EnvironmentFile=/opt/fantasy-football/.env
ExecStart=/opt/fantasy-football/venv/bin/python -m manager run
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
